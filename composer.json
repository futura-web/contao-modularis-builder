{
    "name": "futuraweb/contao-modularis-builder",
    "type": "contao-bundle",
    "description": "HTML-Snippets mit Platzhaltern als wiederverwendbare Inhaltselemente für Contao 5 – ohne eigene Modulprogrammierung",
    "keywords": [
        "contao",
        "contao5",
        "contao-bundle",
        "content-element",
        "snippet",
        "html-snippet",
        "template",
        "dynamic",
        "dynamic-content",
        "placeholder",
        "reusable",
        "backend",
        "editor",
        "cms",
        "image"
    ],
    "homepage": "https://github.com/futura-web/contao-modularis-builder",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Dinko Skopljak",
            "homepage": "https://futura-web.de"
        }
    ],
    "support": {
        "issues": "https://github.com/futura-web/contao-modularis-builder/issues",
        "source": "https://github.com/futura-web/contao-modularis-builder"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0",
        "contao/manager-plugin": "^2.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-foundation": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Futuraweb\\ContaoModularisBuilder\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Futuraweb\\ContaoModularisBuilder\\ContaoManager\\Plugin",
        "contao-metadata-url": "https://raw.githubusercontent.com/futura-web/contao-modularis-builder/main/metadata.json"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    }
}
